{
  "name": "wexample/symfony-remote-pdf-factory",
  "description": "Client of a pdf-factory service: semantic documents and their charter posted, PDF back, declared as a symfony-remote",
  "version": "2.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemotePdfFactory\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemotePdfFactory\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-remote": ">=2.0.0",
    "symfony/http-client": ">=7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}